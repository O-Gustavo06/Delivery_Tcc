DB_PASSWORD=troque-por-uma-senha-sua

# Evolution API (integracao WhatsApp) - servicos evolution-postgres/evolution-api do
# docker-compose.yml. EVOLUTION_API_KEY precisa ser igual ao backend/.env.docker.
# EVOLUTION_DB_PASSWORD vai direto numa connection string (postgresql://...) - evite
# caracteres especiais como # @ / : que quebram a URL, use so letras e numeros.
EVOLUTION_DB_PASSWORD=troque-por-uma-senha-sua
EVOLUTION_API_KEY=troque-por-uma-chave-sua
EVOLUTION_SERVER_URL=http://localhost:8080
