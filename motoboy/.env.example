# Chave do Google Maps pro app do motoboy (mapa + calculo de rota).
# Copie este arquivo pra ".env.local" (que o git ignora) e preencha.
# APIs que precisam estar habilitadas no Google Cloud: "Maps JavaScript API" e "Routes API".
VITE_GOOGLE_MAPS_API_KEY=

# Opcional: posicao da loja. Centro do mapa antes do GPS responder e origem da rota se o GPS for negado.
VITE_EMPRESA_LAT=
VITE_EMPRESA_LNG=
